# Copy to docker/.env and adjust. Every variable below is optional except
# HOST_UID / HOST_GID, which compose.yaml requires so container-written files
# in the bind mount are owned by you rather than root.
#
#   cp docker/env.example docker/.env
#   printf 'HOST_UID=%s\nHOST_GID=%s\n' "$(id -u)" "$(id -g)" >> docker/.env
#
# docker/.env is gitignored; this example file is committed.

# --- Required ---------------------------------------------------------------
HOST_UID=1000
HOST_GID=1000

# --- Image ------------------------------------------------------------------
# What the build is tagged as, and what a pre-built tag overrides. The
# toolchain itself is pinned by ARG RUST_VERSION in the root Dockerfile.
RUSTFLOW_IMAGE=rustflow:latest

# --- Claude Code config source ----------------------------------------------
# What gets bind-mounted as the dev container's Claude Code config dir.
# Defaults to the host's own ~/.claude, which is what keeps the container
# logged in as you. Point it at a different directory to give the container its
# own separate login, or at an empty one to isolate it entirely.
#CLAUDE_CONFIG_SRC=/home/you/.claude

# --- Agent tooling (all optional) -------------------------------------------
# compose.yaml forwards these three by bare name, which passes a variable only
# when it is actually set and omits it otherwise -- so leaving them commented
# out is not the same as setting them empty, and that is the point. An empty
# ANTHROPIC_API_KEY would read as "a key was configured" to Claude Code.
#
# Claude Code's two are usually NOT wanted: the dev service bind-mounts your
# ~/.claude as the container's config dir, so it is already logged in as you.
# They are for a host with no ~/.claude to mount, such as a CI runner --
# CLAUDE_CODE_OAUTH_TOKEN comes from `claude setup-token`.
#
# GH_TOKEN is the one that matters here. It is the only way in-container `gh`
# gets authenticated -- and the only way `git push` works from in there at all,
# since the image has no ssh client for this repo's git@github.com: remote
# (devtools/container-bootstrap.sh turns the token into an HTTPS rewrite at
# container-create time).
#
# A container's environment is fixed when it is CREATED, so setting any of
# these after one is already running has no effect on it: `down`, then up.
#ANTHROPIC_API_KEY=
#CLAUDE_CODE_OAUTH_TOKEN=
#GH_TOKEN=

# --- Cargo ------------------------------------------------------------------
#CARGO_TEST_ARGS=-- --nocapture
#CARGO_TEST_ARGS=graph::                 # run one module's tests
#CARGO_BUILD_ARGS=--release
